theorem closedValue_lower (x y u v : ℝ)
    (hx : 31415/10000 ≤ x ∧ x ≤ 31416/10000)
    (hy : 14142/10000 ≤ y ∧ y ≤ 14143/10000)
    (hu : 9998/10000 ≤ u ∧ u ≤ 1)
    (hv : 1884/100000 ≤ v ∧ v ≤ 1885/100000) :
    (4790274002065539332881844226677501:ℝ)/679562729429049362531250000000000 ≤ closedValue x y u v := by
  have hx0 : 0 < x := lt_of_lt_of_le (by norm_num) hx.1
  have hy0 : 0 ≤ y := le_trans (by norm_num) hy.1
  have hu0 : 0 ≤ u := le_trans (by norm_num) hu.1
  have hv0 : 0 ≤ v := le_trans (by norm_num) hv.1
  have hp : (27799*(471/25000)/25000 + 444784/(23625*(3927/1250)^2) + 27003485520589/(1476562500000*(3927/1250)) + 6246962*(4999/5000)/(2953125*(3927/1250)) + 31006183*(471/25000)/(19687500*(3927/1250)) + 131291794*(7071/5000)*(471/25000)/(44296875*(3927/1250)) + 288912124*(4999/5000)*(7071/5000)/(44296875*(3927/1250)) + 1050334352*(4999/5000)*(7071/5000)/(66976875*(3927/1250)^2)) ≤ (27799*v/25000 + 444784/(23625*x^2) + 27003485520589/(1476562500000*x) + 6246962*u/(2953125*x) + 31006183*v/(19687500*x) + 131291794*y*v/(44296875*x) + 288912124*u*y/(44296875*x) + 1050334352*u*y/(66976875*x^2)) := by
    gcongr <;> linarith [hx.1, hx.2, hy.1, hy.2, hu.1, hu.2, hv.1, hv.2]
  have hn : (5770120277*x/25000000000 + 94977*u/125000 + 26313520697059*y/(3691406250000*x) + 4595551947059*y/(1153564453125*x^2) + 1405018*u/(118125*x^2) + 334739*v/(23625*x^2) + 2311296992*y*v/(66976875*x^2)) ≤ (5770120277*(3927/1250)/25000000000 + 94977*(1)/125000 + 26313520697059*(14143/10000)/(3691406250000*(6283/2000)) + 4595551947059*(14143/10000)/(1153564453125*(6283/2000)^2) + 1405018*(1)/(118125*(6283/2000)^2) + 334739*(377/20000)/(23625*(6283/2000)^2) + 2311296992*(14143/10000)*(377/20000)/(66976875*(6283/2000)^2)) := by
    gcongr <;> linarith [hx.1, hx.2, hy.1, hy.2, hu.1, hu.2, hv.1, hv.2]
  have he : closedValue x y u v = (27799*v/25000 + 444784/(23625*x^2) + 27003485520589/(1476562500000*x) + 6246962*u/(2953125*x) + 31006183*v/(19687500*x) + 131291794*y*v/(44296875*x) + 288912124*u*y/(44296875*x) + 1050334352*u*y/(66976875*x^2)) - (5770120277*x/25000000000 + 94977*u/125000 + 26313520697059*y/(3691406250000*x) + 4595551947059*y/(1153564453125*x^2) + 1405018*u/(118125*x^2) + 334739*v/(23625*x^2) + 2311296992*y*v/(66976875*x^2)) := by unfold closedValue; ring
  rw [he]
  linarith

theorem c1_re_lower : (4790274002065539332881844226677501:ℝ)/679562729429049362531250000000000 ≤ c1.re := by
  rw [c1_re_closed]
  exact closedValue_lower Real.pi r co si pi_bounds sqrt_two_bounds cos_delta_bounds sin_delta_bounds

theorem c1_re_gt_seven : 7 < c1.re := by
  linarith [c1_re_lower]

theorem printed_8_24_is_false : ¬ c1.re < (69955:ℝ)/10000 := by
  linarith [c1_re_gt_seven]

#print axioms c1_re_gt_seven
#print axioms printed_8_24_is_false
end Section8
