def PiEndpointObstruction.UniformCompanions : ℝ → ℝ → Prop :=
fun alpha B =>
  ∀ (p q : ℤ),
    LT.lt.{0} 0 q →
      ∃ P Q,
        LE.le.{0} 0 Q ∧
          LE.le.{0} (↑Q) (HMul.hMul.{0, 0, 0} B ↑q) ∧
            LE.le.{0} (HMul.hMul.{0, 0, 0} (↑q) (abs.{0} (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} (↑Q) alpha) ↑P)))
                (1 / 2) ∧
              Ne.{1} (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} p Q) (HMul.hMul.{0, 0, 0} q P)) 0
def PiEndpointObstruction.UniformIndependentApproximants : ℝ → ℝ → Prop :=
fun alpha B =>
  ∀ (q : ℤ),
    LT.lt.{0} 0 q →
      ∃ P1 Q1 P2 Q2,
        LT.lt.{0} 0 Q1 ∧
          LT.lt.{0} 0 Q2 ∧
            LE.le.{0} (↑Q1) (HMul.hMul.{0, 0, 0} B ↑q) ∧
              LE.le.{0} (↑Q2) (HMul.hMul.{0, 0, 0} B ↑q) ∧
                LE.le.{0}
                    (HMul.hMul.{0, 0, 0} (↑q) (abs.{0} (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} (↑Q1) alpha) ↑P1)))
                    (1 / 2) ∧
                  LE.le.{0}
                      (HMul.hMul.{0, 0, 0} (↑q) (abs.{0} (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} (↑Q2) alpha) ↑P2)))
                      (1 / 2) ∧
                    Ne.{1} (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} P1 Q2) (HMul.hMul.{0, 0, 0} P2 Q1)) 0
