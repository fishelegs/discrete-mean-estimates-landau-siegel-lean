      throwError "Unexpected owner/name pair {owner} {name}"
  for p in expectedOwned do
    unless keys.contains (p.1,p.2.1) do
      throwError "Missing owner/name pair {p.1} {p.2.1}"
  for (owner,name) in keys do
    let ci ← getConstInfo name
    if ci.isAxiom then throwError "Owned axiom {name}"
    let axs ← collectAxioms name
    unless axs.all (fun a => a == ``propext || a == ``Classical.choice || a == ``Quot.sound) do
      throwError "Nonstandard transitive axiom at {name}: {axs}"
    let some pin := expectedOwned.find? (fun p => p.1 == owner && p.2.1 == name)
      | throwError "Missing owner/type pin {owner} {name}"
    unless reprStr ci.type == pin.2.2.1 do
      throwError "Full elaborated type drift {name}"
    unless reprStr ci.levelParams == pin.2.2.2 do
      throwError "Universe parameter drift {name}"
    let typePretty ← liftTermElabM <| Meta.ppExpr ci.type
    let row := Json.mkObj [
      ("owner", toJson owner.toString),
      ("name", toJson name.toString),
      ("type_repr", toJson (reprStr ci.type)),
      ("type_lean_hash64", toJson (toString (hash typePretty.pretty))),
      ("type_pretty", toJson typePretty.pretty),
      ("universe_parameters_repr", toJson (reprStr ci.levelParams)),
      ("axioms", toJson (axs.map Name.toString)),
      ("used_constants", toJson (ci.getUsedConstantsAsSet.toArray.map Name.toString))]
    out.putStrLn s!"DECLARATION_JSON {row.compress}"
  unless codegenKeys.size == expectedCodegen.size do
    throwError "Codegen inventory cardinality drift"
  for p in expectedCodegen do
    unless codegenKeys.contains (p.1,p.2.1) do
      throwError "Missing codegen owner/name {p.1} {p.2.1}"
  for (owner,name) in codegenKeys do
    let some pin := expectedCodegen.find? (fun p => p.1 == owner && p.2.1 == name)
      | throwError "Unexpected codegen owner/name {owner} {name}"
    let some ir := IR.findEnvDecl env name
      | throwError "Unresolved codegen-only declaration {owner} {name}"
    unless toString ir == pin.2.2 do
      throwError "Codegen IR drift {name}"
    let row := Json.mkObj [("owner", toJson owner.toString), ("name", toJson name.toString),
      ("ir", toJson (toString ir)), ("kind", toJson "codegen-only; no kernel ConstantInfo")]
    out.putStrLn s!"CODEGEN_JSON {row.compress}"
  out.putStrLn s!"OWNERSHIP_TYPE_AXIOM_EXACT_PASS {keys.size} CODEGEN {codegenKeys.size}"
  out.flush
