    (OAI.PiExponent.BlowupJetSurjectivity.blowupBundle (OAI.PiExponent.AdmissibleBlowupGeometry.centerIdeal d)
      (OAI.PiExponent.AdmissibleBlowupGeometry.hyperplane d))
'OAI.PiExponent.AdmissibleJetSurjectivity.blowupBundle_ample' depends on axioms: [propext, Classical.choice, Quot.sound]
