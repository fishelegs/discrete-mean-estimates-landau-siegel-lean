@OAI.PiExponent.LiteralAnalytic.actual_minor_analytic_bound : ∀ {nu : ℝ}
  (d : OAI.PiExponent.DeterminantContradiction.FixedData nu),
  0 ≤ nu →
    ∀ {H : ℝ},
      0 < H →
        ∀
          (selection :
            OAI.PiExponent.DeterminantContradiction.Row d H → OAI.PiExponent.DeterminantContradiction.Column d H),
          (OAI.PiExponent.DeterminantContradiction.actualMinor d H selection).det ≠ 0 →
            Real.log ‖(OAI.PiExponent.DeterminantContradiction.actualMinor d H selection).det‖ /
                (↑(OAI.PiExponent.DeterminantContradiction.actualRowCount d H) * H) ≤
              OAI.PiExponent.AdmissibleParameters.analyticError d +
                  OAI.PiExponent.LiteralAnalytic.analyticRemainder d H +
                max (-OAI.PiExponent.DeterminantContradiction.collisionRate d H)
                  (-nu * (↑d.base.A * (1 - d.base.eta) - OAI.PiExponent.DeterminantContradiction.actualMean d H))
'OAI.PiExponent.LiteralAnalytic.actual_minor_analytic_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
