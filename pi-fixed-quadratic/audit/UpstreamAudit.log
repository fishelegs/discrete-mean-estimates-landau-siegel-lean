def OAI.PiExponent.DeterminantContradiction.AnalyticAggregateStatement : Prop :=
∀ (nu : ℝ),
  2 < nu →
    ∀ (d : OAI.PiExponent.DeterminantContradiction.FixedData nu),
      ∃ error,
        Filter.Tendsto error Filter.atTop (nhds 0) ∧
          ∀ᶠ (H : ℝ) in Filter.atTop,
            ∀
              (selection :
