                            0 ≤ F →
                              0 < v →
                                0 < w0 →
                                  0 < wmin →
                                    0 < D →
                                      (∀ (i : Fin m), wmin ≤ w i) →
                                        (∀ (i : Fin m), ↑(T i) ≤ F * w i / v + 1) →
                                          ∑ i, w i * ↑(FixedQuadratic.minorDegrees a b i) ≤ D * (1 - rebate) →
                                            0 ≤ rebate →
                                              ↑(∑ r, s r) ≤ D / v →
                                                ↑(∑ c, h c) ≤ D / w0 →
                                                  ↑(∑ c, ∑ i, a c i) ≤ D / wmin →
                                                    (∀ (i : Fin m), Real.log (⋯ * ⋯) ≤ w i + Real.log √3) →
                                                      -(1 - rebate) - FixedQuadratic.arithmeticError F v w0 wmin k -
                                                          Real.log ↑(Fintype.card ι).factorial / D ≤
                                                        Real.log ‖⋯‖ / D
