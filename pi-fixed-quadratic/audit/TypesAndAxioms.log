theorem FixedQuadratic.determinant_clearing.{u_1, u_2, u_3} : ∀ {ι : Type u_1} {σ : Type u_2} {R : Type u_3}
  [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : Fintype σ] [inst_3 : CommRing R] (S : Subring R)
  (A : Matrix ι ι R) (L : σ → R) (α b : ι → σ → ℕ),
  (∀ (r c : ι), (¬∀ (i : σ), b r i ≤ α c i) → A r c = 0) →
    (∀ (r c : ι), (∏ i, L i ^ (α c i - b r i)) * A r c ∈ S) → (∏ i, L i ^ (∑ c, α c i - ∑ r, b r i)) * A.det ∈ S :=
fun {ι} {σ} {R} [Fintype ι] [DecidableEq ι] [Fintype σ] [CommRing R] S A L α b hzero hclear =>
  Eq.mpr (id (congrArg (fun _a => (∏ i, L i ^ (∑ c, α c i - ∑ r, b r i)) * _a ∈ S) (Matrix.det_apply' A)))
    (Eq.mpr
      (id
        (congrArg (fun _a => _a ∈ S)
          (Finset.mul_sum Finset.univ (fun σ => ↑↑(Equiv.Perm.sign σ) * ∏ i, A (σ i) i)
            (∏ i, L i ^ (∑ c, α c i - ∑ r, b r i)))))
      (Subring.sum_mem S fun p hp =>
        if h : ∀ (c : ι) (i : σ), b (p c) i ≤ α c i then
          have he :=
            Eq.mpr (id (congrArg (fun _a => ∏ i, L i ^ (∑ c, α c i - ∑ r, b r i) = _a) Finset.prod_comm))
              (Finset.prod_congr rfl fun i hi =>
                Eq.mpr
                  (id
                    (congrArg (fun _a => L i ^ (∑ c, α c i - ∑ r, b r i) = _a)
                      (Finset.prod_pow_eq_pow_sum Finset.univ (fun x => α x i - b (p x) i) (L i))))
                  (Eq.mpr
                    (id
                      (congrArg (fun _a => L i ^ (∑ c, α c i - ∑ r, b r i) = L i ^ _a)
                        (FixedQuadratic.matched_sum_sub (fun c => α c i) (fun r => b r i) p fun c => h c i)))
                    (Eq.refl (L i ^ (∑ c, α c i - ∑ r, b r i)))));
          Eq.mpr (id (congrArg (fun _a => _a * (↑↑(Equiv.Perm.sign p) * ∏ i, A (p i) i) ∈ S) he))
            (have hh := Subring.prod_mem S fun c x => hclear (p c) c;
            have ht := Subring.mul_mem S (intCast_mem S ↑(Equiv.Perm.sign p)) hh;
            Eq.mp
              (congrArg (Membership.mem S)
                (Eq.trans (congrArg (HMul.hMul ↑↑(Equiv.Perm.sign p)) Finset.prod_mul_distrib)
                  (mul_left_comm (↑↑(Equiv.Perm.sign p)) (∏ x, ∏ i, L i ^ (α x i - b (p x) i)) (∏ x, A (p x) x))))
              ht)
        else
          Exists.casesOn
            (Eq.mp
              (Eq.trans (Mathlib.Tactic.Push.not_forall_eq fun c => ∀ (i : σ), b (p c) i ≤ α c i)
                (congrArg Exists
                  (funext fun c =>
                    Eq.trans (Mathlib.Tactic.Push.not_forall_eq fun i => b (p c) i ≤ α c i)
                      (congrArg Exists (funext fun i => not_le._simp_1)))))
              h)
            fun c h =>
            Exists.casesOn h fun i hi =>
              have hz := hzero (p c) c fun hh => not_le_of_gt hi (hh i);
              have hpz := Finset.prod_eq_zero (Finset.mem_univ c) hz;
              of_eq_true
                (Eq.trans
                  (congrArg (Membership.mem S)
                    (Eq.trans
                      (congrArg (HMul.hMul (∏ i, L i ^ (∑ c, α c i - ∑ r, b r i)))
                        (Eq.trans (congrArg (HMul.hMul ↑↑(Equiv.Perm.sign p)) hpz) (mul_zero ↑↑(Equiv.Perm.sign p))))
                      (mul_zero (∏ i, L i ^ (∑ c, α c i - ∑ r, b r i)))))
                  (ZeroMemClass.zero_mem._simp_1 S))))
