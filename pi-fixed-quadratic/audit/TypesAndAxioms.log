theorem FixedQuadratic.simultaneous_conjugate_evaluation.{u_1, u_2, u_3} : ∀ {σ : Type u_1} {R : Type u_2}
  {K : Type u_3} [inst : CommSemiring R] [inst_1 : Field K] (P : MvPolynomial σ R) (φ : R →+* K) (τ : K ≃+* K)
  (β : σ → K), τ.toRingHom.comp φ = φ → τ (MvPolynomial.eval₂ φ β P) = MvPolynomial.eval₂ φ (fun i => τ (β i)) P :=
fun {σ} {R} {K} [CommSemiring R] [Field K] P φ τ β hfix =>
  id
    (Eq.mpr
      (id
        (congrArg (fun _a => _a = MvPolynomial.eval₂ φ (⇑τ.toRingHom ∘ β) P)
          (MvPolynomial.eval₂_comp_left τ.toRingHom φ β P)))
      (Eq.mpr
        (id
          (congrArg (fun _a => MvPolynomial.eval₂ _a (⇑τ.toRingHom ∘ β) P = MvPolynomial.eval₂ φ (⇑τ.toRingHom ∘ β) P)
            hfix))
        (Eq.refl (MvPolynomial.eval₂ φ (⇑τ.toRingHom ∘ β) P))))
