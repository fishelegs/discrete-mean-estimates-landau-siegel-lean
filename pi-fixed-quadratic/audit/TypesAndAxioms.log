  [inst_5 : Algebra G K] [inst_6 : Algebra GaussianInt K] [IsScalarTower GaussianInt G K] [FiniteDimensional G K]
  [IsGalois G K] [inst_10 : Fintype ι] [inst_11 : DecidableEq ι] {m : ℕ},
  Module.finrank G K = 2 →
    ∀ (τ : Gal(K/G)),
      τ ≠ 1 →
        ∀ (T : Fin m → ℕ) (k : ℕ) (j s h : ι → ℕ) (b a : ι → Fin m → ℕ),
          (∀ (r : ι), j r ≤ k) →
            ∀ (la lb lc : Fin m → ℤ) (x : Fin m → K),
              (∀ (i : Fin m), (↑((la i).gcd (lb i))).gcd (lc i) = 1) →
                (∀ (i : Fin m),
                    Polynomial.C ↑(la i) * Polynomial.X ^ 2 + Polynomial.C ↑(lb i) * Polynomial.X +
                        Polynomial.C ↑(lc i) =
                      Polynomial.C ↑(la i) *
                        ((Polynomial.X - Polynomial.C (x i)) * (Polynomial.X - Polynomial.C (τ (x i))))) →
                  (∀ (i : Fin m), la i ≠ 0) →
                    ∀ (φ : K →+* ℂ),
                      φ.comp (algebraMap GaussianInt K) = GaussianInt.toComplex →
                        (MvPolynomial.eval fun i => φ (x i)) (FixedQuadratic.formalMinor T j s h b a) ≠ 0 →
