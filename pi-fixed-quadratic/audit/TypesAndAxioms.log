theorem FixedQuadratic.simultaneous_conjugate_ne_zero.{u_1, u_2, u_3} : ∀ {σ : Type u_1} {R : Type u_2} {K : Type u_3}
  [inst : CommSemiring R] [inst_1 : Field K] (P : MvPolynomial σ R) (φ : R →+* K) (τ : K ≃+* K) (β : σ → K),
  τ.toRingHom.comp φ = φ → MvPolynomial.eval₂ φ β P ≠ 0 → MvPolynomial.eval₂ φ (fun i => τ (β i)) P ≠ 0 :=
fun {σ} {R} {K} [CommSemiring R] [Field K] P φ τ β hfix hne =>
  Eq.mpr (id (congrArg (fun _a => _a ≠ 0) (Eq.symm (FixedQuadratic.simultaneous_conjugate_evaluation P φ τ β hfix))))
    fun h =>
    hne
      (RingEquiv.injective τ
        (Eq.mpr
          (id
            (Eq.trans (congrArg (Eq (τ (MvPolynomial.eval₂ φ β P))) (map_zero τ))
              EmbeddingLike.map_eq_zero_iff._simp_1))
          (Eq.mp EmbeddingLike.map_eq_zero_iff._simp_1 h)))
